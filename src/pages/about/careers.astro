---
// Careers. The real proudtosmile.com publishes no careers content and no open
// roles, so this page invites enquiries through the practice's real phone
// number rather than inventing job listings or a hiring process.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import ArrowCircle from '../../components/ArrowCircle.astro';
import { PHONE, PHONE_HREF, ADDRESS } from '../../data/site';
---

<BaseLayout
  title="Careers in Bernardsville, NJ | Proud To Smile"
  description="Interested in joining Proud To Smile Dentistry in Bernardsville, NJ? Get in touch with our team about current and future openings."
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'About', href: '/about/' }, { label: 'Careers' }]} />

    <PageHero
      title="Work With Us"
      intro="We are a small, close-knit practice where people tend to stay. If that sounds like the kind of place you want to work, we would like to hear from you."
      image="/images/proudtosmile/office-collage.webp"
      imageAlt="The Proud To Smile Dentistry team at work in Bernardsville, NJ"
    />

    <section class="py-[var(--spacing-section)]" aria-labelledby="openings-heading">
      <div class="container-page">
        <div class="max-w-3xl">
          <h2 id="openings-heading">Current Openings</h2>
          <p class="mt-6 text-neutral-700">
            We don&rsquo;t have a formal listing posted at the moment. We do keep résumés on file,
            and roles open up as the practice grows — hygienists, dental assistants, and patient
            care coordinators.
          </p>
          <p class="mt-4 text-neutral-700">
            The best way to start a conversation is simply to call the office and ask for the
            practice manager.
          </p>

          <div class="card mt-10 border-t-4 border-t-accent-200">
            <h3 class="text-xl">Get in Touch</h3>
            <p class="mt-3 text-neutral-700">
              Call <a href={PHONE_HREF} class="font-semibold text-primary-700 hover:underline">{PHONE}</a>
              during office hours, or stop by — we are at {ADDRESS}.
            </p>
            <a href="/locations/bernardsville/" class="link-arrow mt-6">
              Office Hours &amp; Directions
              <ArrowCircle />
            </a>
          </div>
        </div>
      </div>
    </section>

    <CtaSection
      heading="Have a Question About Working Here?"
      text={`Call ${PHONE} and ask for the practice manager.`}
    />
  </main>

  <Footer />
</BaseLayout>
