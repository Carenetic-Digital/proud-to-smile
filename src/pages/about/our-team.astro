---
// Our Team — the support staff the real /providers page lists by first name.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import ArrowCircle from '../../components/ArrowCircle.astro';
import { doctors, supportTeam } from '../../data/doctors';
---

<BaseLayout
  title="Our Team in Bernardsville, NJ | Proud To Smile"
  description="Meet the hygienists, dental assistants, and patient care coordinators behind Proud To Smile Dentistry in Bernardsville, NJ."
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'About', href: '/about/' }, { label: 'Our Team' }]} />

    <PageHero
      title="Compassionate Dental Professionals"
      intro="From your first phone call to your last polish, a close-knit team looks after every visit — most of them have been here for years."
      image="/images/proudtosmile/office-collage.webp"
      imageAlt="The Proud To Smile Dentistry team at work"
    />

    <section class="py-[var(--spacing-section)]" aria-labelledby="clinical-heading">
      <div class="container-page">
        <h2 id="clinical-heading">Clinical Providers</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            doctors.map((doctor) => (
              <div class="card flex items-center gap-5">
                <img
                  src={doctor.image}
                  alt={doctor.imageAlt}
                  width={doctor.imageWidth}
                  height={doctor.imageHeight}
                  loading="lazy"
                  class="h-28 w-24 shrink-0 rounded-[var(--radius-sm)] object-cover object-top"
                />
                <div>
                  <h3 class="text-xl">
                    {doctor.name}, {doctor.credentials}
                  </h3>
                  <p class="mt-1 text-sm text-neutral-700">{doctor.title}</p>
                  <a href={`/doctors/${doctor.slug}/`} class="link-arrow mt-3">
                    View Profile
                    <ArrowCircle />
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-secondary-50 py-[var(--spacing-section)]" aria-labelledby="support-heading">
      <div class="container-page">
        <h2 id="support-heading">Assistants &amp; Patient Care</h2>
        <p class="mt-6 max-w-3xl text-neutral-700">
          The people who greet you, coordinate your treatment plan, sort out your insurance, and
          keep the day running.
        </p>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            supportTeam.map((member) => (
              <div class="card">
                <h3 class="text-xl">{member.name}</h3>
                <p class="mt-1 text-sm font-semibold text-primary-700">{member.role}</p>
                <p class="mt-3 text-sm text-neutral-700">{member.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
