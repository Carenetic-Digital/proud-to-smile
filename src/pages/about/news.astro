---
// News & Press index.
//
// Per state.json -> pages.notes.news_press, the client wants a real news
// section (press mentions, speaking engagements, new-hire announcements) but
// has not supplied the content yet. The reference site's 10 demo news posts
// were deliberately dropped. This page is the section index, standing ready —
// it does NOT fabricate articles.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import ArrowCircle from '../../components/ArrowCircle.astro';
---

<BaseLayout
  title="News & Press in Bernardsville, NJ | Proud To Smile"
  description="Press mentions, speaking engagements, and practice announcements from Proud To Smile Dentistry in Bernardsville, NJ."
  noindex={true}
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'About', href: '/about/' }, { label: 'News & Press' }]} />

    <PageHero
      title="News &amp; Press"
      intro="Press mentions, speaking engagements, and announcements from the practice."
    />

    <section class="py-[var(--spacing-section)]">
      <div class="container-page">
        <div class="card max-w-2xl border-l-4 border-l-primary-600">
          <h2 class="text-xl">This section is being prepared</h2>
          <p class="mt-3 text-neutral-700">
            We&rsquo;re gathering our press coverage and practice announcements. In the meantime,
            our blog has the latest from the office.
          </p>
          <a href="/blog/" class="link-arrow mt-6">
            Read the Blog
            <ArrowCircle />
          </a>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
