---
// Testimonials — all 26 real reviews from the live /testimonials page.
// NEVER add a review that isn't in reference/content-proudtosmile.md section 5.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { testimonials, featuredTestimonials } from '../data/testimonials';
import { RATING, PRACTICE } from '../data/site';
---

<BaseLayout
  title={`Patient Reviews | ${PRACTICE}`}
  description="Read what patients say about Dr. Patricia Swaintek-Lamb, Karima West, RDH, and the team at Proud To Smile Dentistry in Bernardsville, NJ. Rated 4.96 on Google."
>
  <Header currentPath="/testimonials/" />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'Testimonials' }]} />

    <PageHero title="What Our Patients Say" intro="Rated 4.96 on Google — here's why, in our patients' own words.">
      <div class="mt-8 flex items-center gap-3">
        <span class="flex" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg class="h-6 w-6 fill-current text-primary-600" viewBox="0 0 20 20">
                <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.62.99-5.8-4.21-4.1 5.82-.85L10 1.5Z" />
              </svg>
            ))
          }
        </span>
        <span class="text-2xl font-bold text-neutral-900">{RATING}</span>
        <span class="text-neutral-700">average on Google</span>
      </div>
    </PageHero>

    <!-- The longer quotes the practice features -->
    <section class="py-[var(--spacing-section)]" aria-labelledby="featured-heading">
      <div class="container-page">
        <h2 id="featured-heading" class="sr-only">Featured reviews</h2>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          {
            featuredTestimonials.map((t) => (
              <blockquote class="card flex flex-col border-t-4 border-t-accent-200">
                <p class="flex-1 text-lg leading-relaxed text-neutral-700">&ldquo;{t.quote}&rdquo;</p>
                <footer class="mt-6 text-sm">
                  <cite class="not-italic font-semibold text-neutral-900">{t.author}</cite>
                  <span class="text-neutral-700"> · {t.context}</span>
                </footer>
              </blockquote>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Every review from the practice's reviews page -->
    <section class="bg-secondary-50 py-[var(--spacing-section)]" aria-labelledby="all-heading">
      <div class="container-page">
        <h2 id="all-heading">More Patient Reviews</h2>
        <p class="mt-6 max-w-3xl text-neutral-700">
          {testimonials.length} reviews from patients treated between April 2023 and October 2025.
        </p>
        <ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            testimonials.map((t) => (
              <li class="card flex flex-col">
                <blockquote class="flex flex-1 flex-col">
                  <p class="flex-1 text-neutral-700">&ldquo;{t.quote}&rdquo;</p>
                  <footer class="mt-5 text-sm">
                    <cite class="not-italic font-semibold text-neutral-900">{t.author}</cite>
                    <span class="text-neutral-700"> · {t.context}</span>
                  </footer>
                </blockquote>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
