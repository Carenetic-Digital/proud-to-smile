---
// Testimonials — all 26 real reviews from the live /testimonials page.
// NEVER add a review that isn't in reference/content-proudtosmile.md section 5.
//
// STAGING: both card grids are swapped for an EmbedPlaceholder while the
// practice stands up its ELFsight reviews widget. The reviews themselves stay
// in src/data/testimonials.ts so restoring the grids is a one-commit revert —
// do not delete the data.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import EmbedPlaceholder from '../components/EmbedPlaceholder.astro';
import { RATING, PRACTICE } from '../data/site';
---

<BaseLayout
  title={`Patient Reviews | ${PRACTICE}`}
  description="Read what patients say about Dr. Patricia Swaintek-Lamb, Karima West, RDH, and the team at Proud To Smile Dentistry in Bernardsville, NJ. Rated 4.96 on Google."
>
  <Header currentPath="/testimonials/" />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'Testimonials' }]} />

    <PageHero title="What Our Patients Say" intro="Rated 4.96 on Google — here's why, in our patients' own words.">
      <div class="mt-8 flex items-center gap-3">
        <span class="flex" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg class="h-6 w-6 fill-current text-primary-600" viewBox="0 0 20 20">
                <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.62.99-5.8-4.21-4.1 5.82-.85L10 1.5Z" />
              </svg>
            ))
          }
        </span>
        <span class="text-2xl font-bold text-neutral-900">{RATING}</span>
        <span class="text-neutral-700">average on Google</span>
      </div>
    </PageHero>

    {/* Patient reviews — ELFsight widget drops in here */}
    <section class="py-[var(--spacing-section)]" aria-labelledby="reviews-heading">
      <div class="container-page">
        <h2 id="reviews-heading" class="sr-only">Patient reviews</h2>
        <EmbedPlaceholder
          label="An ELFsight reviews embed will be added here"
          minHeight="30rem"
        />
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
