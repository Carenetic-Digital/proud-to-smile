---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArrowCircle from '../components/ArrowCircle.astro';
---

<BaseLayout title="Page Not Found | Proud To Smile Dentistry" noindex={true}>
  <Header />
  <main id="main-content" class="flex min-h-[60vh] items-center justify-center bg-primary-50 px-4 py-24">
    <div class="max-w-md text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary-700">404</p>
      <h1 class="mt-2 text-neutral-900">We couldn't find that page</h1>
      <p class="mt-4 text-neutral-700">
        The page you're looking for may have moved or no longer exists. Let's get you back to your
        dental home in Bernardsville.
      </p>
      <a href="/" class="btn btn-primary mt-8">
        Return Home
        <ArrowCircle />
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
