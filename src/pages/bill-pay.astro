---
// Bill Pay. The real practice takes payment through the MyDentistLink patient
// portal — there is no separate payment gateway on the site, so this page
// routes there rather than implying an online checkout the practice lacks.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowCircle from '../components/ArrowCircle.astro';
import { PHONE, PHONE_HREF, PATIENT_PORTAL_URL } from '../data/site';
---

<BaseLayout
  title="Pay Your Bill in Bernardsville, NJ | Proud To Smile"
  description="Pay your balance online through the Proud To Smile Dentistry patient portal, or call 908-221-1188 to settle by phone."
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'Bill Pay' }]} />

    <PageHero title="Pay Your Bill" intro="Settle your balance online through our secure patient portal, or over the phone during office hours." />

    <section class="py-[var(--spacing-section)]" aria-labelledby="pay-heading">
      <div class="container-page">
        <div class="grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="card border-t-4 border-t-accent-200">
            <h2 id="pay-heading" class="text-xl">Pay Online</h2>
            <p class="mt-3 text-neutral-700">
              Sign in to the patient portal to view and pay your balance.
            </p>
            <a href={PATIENT_PORTAL_URL} target="_blank" rel="noopener" class="btn btn-primary mt-6">
              Open Patient Portal
              <ArrowCircle />
            </a>
          </div>

          <div class="card border-t-4 border-t-accent-200">
            <h2 class="text-xl">Pay by Phone</h2>
            <p class="mt-3 text-neutral-700">
              Call the office during opening hours and we&rsquo;ll take payment over the phone.
            </p>
            <a href={PHONE_HREF} class="btn btn-outline mt-6">
              Call {PHONE}
              <ArrowCircle />
            </a>
          </div>
        </div>

        <p class="mt-10 max-w-3xl text-sm text-neutral-700">
          Questions about a statement? Call us — our patient care coordinator handles billing and
          insurance coordination and can walk you through the detail.
        </p>
        <a href="/patient-center/financial-options/" class="link-arrow mt-4">
          Explore Financial Options
          <ArrowCircle />
        </a>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
