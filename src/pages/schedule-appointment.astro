---
// Schedule Appointment — a landing page for the practice's real booking
// channels. Per the client decision, phone is the primary CTA and ZocDoc is
// promoted but secondary. The real site has no native booking form, so this
// page does not fake one.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowCircle from '../components/ArrowCircle.astro';
import {
  PHONE, PHONE_HREF, ZOCDOC_URL, PATIENT_FORMS_URL, ADDRESS, HOURS, MAPS_URL,
} from '../data/site';
---

<BaseLayout
  title="Schedule an Appointment | Proud To Smile Dentistry"
  description="Book your appointment at Proud To Smile Dentistry in Bernardsville, NJ. Call 908-221-1188 or schedule online through ZocDoc."
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'Schedule Appointment' }]} />

    <PageHero
      title="Schedule Your Appointment"
      intro="Two ways to book — call us and speak to someone, or reserve a slot online in under a minute."
    />

    <section class="py-[var(--spacing-section)]" aria-labelledby="book-heading">
      <div class="container-page">
        <h2 id="book-heading" class="sr-only">Ways to book</h2>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <div class="card border-t-4 border-t-accent-200">
            <h3 class="text-xl">Call the Office</h3>
            <p class="mt-3 text-sm text-neutral-700">
              The fastest way, and the best if you need an emergency slot or want to ask something
              first.
            </p>
            <a href={PHONE_HREF} class="btn btn-primary mt-6">
              Call {PHONE}
              <ArrowCircle />
            </a>
          </div>

          <div class="card border-t-4 border-t-accent-200">
            <h3 class="text-xl">Book Online</h3>
            <p class="mt-3 text-sm text-neutral-700">
              Pick a time that suits you through ZocDoc, any hour of the day.
            </p>
            <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn btn-outline mt-6">
              Book via ZocDoc
              <ArrowCircle />
            </a>
          </div>

          <div class="card border-t-4 border-t-accent-200">
            <h3 class="text-xl">Then Save Time</h3>
            <p class="mt-3 text-sm text-neutral-700">
              Complete your intake forms online before you arrive.
            </p>
            <a href={PATIENT_FORMS_URL} target="_blank" rel="noopener" class="btn btn-outline mt-6">
              Fill Out Forms
              <ArrowCircle />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-secondary-50 py-[var(--spacing-section)]" aria-labelledby="when-heading">
      <div class="container-page">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h2 id="when-heading">When We're Open</h2>
            <ul class="mt-6 max-w-sm space-y-2 text-neutral-700">
              {
                HOURS.map((h) => (
                  <li class="flex justify-between gap-4 border-b border-border pb-2">
                    <span class="font-medium text-neutral-900">{h.day}</span>
                    <span>{h.time}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2>Where to Find Us</h2>
            <address class="mt-6 not-italic text-neutral-700">{ADDRESS}</address>
            <div class="mt-6 flex flex-wrap gap-4">
              <a href={MAPS_URL} target="_blank" rel="noopener" class="link-arrow">
                Get Directions
                <ArrowCircle />
              </a>
              <a href="/locations/bernardsville/" class="link-arrow">
                Location Details
                <ArrowCircle />
              </a>
            </div>
            <p class="mt-8 text-sm text-neutral-700">
              Dental emergency? Call us — we leave room in the schedule for patients who need to be
              seen immediately.
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
