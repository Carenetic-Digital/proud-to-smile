---
// Legal / compliance page template.
//
// Renders the 11 documents in src/data/legal.ts at their own top-level URLs
// (/privacy-policy/, /terms-conditions/, and so on) — matching the reference
// site's flat legal URL structure and the footer link row.
//
// This is a dynamic route at the site root, but getStaticPaths only ever emits
// the 11 legal slugs, and Astro gives static routes precedence, so it cannot
// shadow another page.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { legalDocs } from '../data/legal';
import { ADDRESS, PHONE, PHONE_HREF } from '../data/site';

export const getStaticPaths = (() =>
  legalDocs.map((doc) => ({ params: { legal: doc.slug }, props: { doc } }))) satisfies GetStaticPaths;

const { doc } = Astro.props;

// Build date, so the page states when the text was last revised rather than
// silently going stale. Rendered at build time only — static output.
const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={doc.seoTitle} description={doc.description}>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: doc.title }]} />

    <PageHero title={doc.title} intro={doc.intro} />

    <section class="py-[var(--spacing-section)]">
      <div class="container-page">
        <div class="max-w-3xl">
          <p class="text-sm text-neutral-600">Last updated: {lastUpdated}</p>

          <div class="mt-10 space-y-12">
            {
              doc.sections.map((section) => (
                <section>
                  <h2 class="text-2xl">{section.heading}</h2>
                  {section.body.map((para) => (
                    <p class="mt-4 text-neutral-700">{para}</p>
                  ))}
                  {section.list && (
                    <ul class="mt-4 space-y-3">
                      {section.list.map((item) => (
                        <li class="flex gap-3 text-neutral-700">
                          <span
                            class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-600"
                            aria-hidden="true"
                          />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              ))
            }
          </div>

          <div class="card mt-14 border-t-4 border-t-accent-200">
            <h2 class="text-xl">Contact the Practice</h2>
            <address class="mt-3 not-italic text-neutral-700">
              Proud To Smile Dentistry<br />
              {ADDRESS}<br />
              <a href={PHONE_HREF} class="font-semibold text-primary-700 hover:underline">{PHONE}</a>
            </address>
          </div>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
