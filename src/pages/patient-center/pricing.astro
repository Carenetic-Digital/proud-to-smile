---
// Pricing.
//
// The real site publishes no fee schedule. This page explains how cost is
// handled without inventing prices — quoting a figure the practice has not
// published would be a serious content-accuracy breach.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import ArrowCircle from '../../components/ArrowCircle.astro';
import { PHONE, PHONE_HREF } from '../../data/site';
---

<BaseLayout
  title="Pricing in Bernardsville, NJ | Proud To Smile"
  description="How Proud To Smile Dentistry handles the cost of treatment — clear estimates before you commit. Call 908-221-1188 for a quote on your specific care."
>
  <Header />

  <main id="main-content">
    <Breadcrumbs crumbs={[{ label: 'Patient Center', href: '/patient-center/' }, { label: 'Pricing' }]} />

    <PageHero
      title="Transparent Pricing"
      intro="Quality dental care should be accessible. Here's how we handle cost, so there are no surprises when the treatment plan arrives."
    />

    <section class="py-[var(--spacing-section)]" aria-labelledby="pricing-heading">
      <div class="container-page">
        <div class="max-w-3xl">
          <h2 id="pricing-heading">How Cost Works Here</h2>
          <p class="mt-6 text-neutral-700">
            Dental treatment is priced per procedure, and what you actually pay depends on your
            insurance plan, the complexity of your case, and the materials involved. That means a
            published price list would mislead more often than it helped.
          </p>
          <p class="mt-4 text-neutral-700">
            Instead, we give you a written estimate for your specific treatment plan before any work
            begins — itemised, with your insurance contribution applied, so you know your out-of-pocket
            cost in advance.
          </p>

          <h3 class="mt-10 text-xl">What You Can Expect</h3>
          <ul class="mt-4 space-y-3">
            {
              [
                'A comprehensive exam before any treatment is recommended',
                'An itemised treatment plan with the cost of each procedure',
                'Your insurance benefits applied to that estimate before you decide',
                'A conversation about what is urgent and what can wait, if cost is a concern',
              ].map((item) => (
                <li class="flex gap-3 text-neutral-700">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-600" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="card mt-10 border-t-4 border-t-accent-200">
            <h3 class="text-xl">Ask for an Estimate</h3>
            <p class="mt-3 text-neutral-700">
              Tell us what you need and we&rsquo;ll tell you what it costs. Call
              <a href={PHONE_HREF} class="font-semibold text-primary-700 hover:underline">{PHONE}</a>.
            </p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a href="/patient-center/insurance/" class="link-arrow">
                Check Your Insurance
                <ArrowCircle />
              </a>
              <a href="/patient-center/financial-options/" class="link-arrow">
                Explore Financial Options
                <ArrowCircle />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
