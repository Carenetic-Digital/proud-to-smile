---
// Homepage — the client-approved design (formerly Concept C / homepage-v3).
//
// Section architecture is a close structural clone of the design reference
// (pdp.carenetic.digital), reskinned in the Proud To Smile palette and
// populated only with real content from reference/content-proudtosmile.md:
//   1. Hero (split: copy left, photo bleeding to band edges right, Google rating)
//   2. Insurance strip (thin dark full-width band)
//   3. Full-width office photograph band
//   4. "What Sets Us Apart" (heading + intro left, 2x2 link blocks right)
//   5. Testimonials (large dark rounded panel, decorative quote glyph)
//   6. "Discover Quality Dental Care for Every Smile" (2-col service blocks)
//   7. "Everything You Need for Better Dental Care" (tinted bg, 4-col cards)
//   8. Closing CTA (white card floating on a dark gradient band)
//
// Deviations from the reference, all per client decisions in
// .site-factory/state.json → pages.notes:
//   - Single Bernardsville location, so the reference's "Our Locations" block
//     becomes "Visit Our Office" and "Find Location" CTAs become the phone.
//   - Phone is the primary CTA; ZocDoc booking is promoted but secondary.
//   - "Clear Aligner Therapy", never "Invisalign", in on-page copy.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import TestimonialPanel from '../components/TestimonialPanel.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowCircle from '../components/ArrowCircle.astro';
import { focusFor } from '../data/imageFocus';

// "What Sets Us Apart" — the reference's 2x2 block of text links.
const apartBlocks = [
  {
    title: 'Meet Dr. Patti',
    text: 'Dr. Patricia Swaintek-Lamb, DMD brings over 25 years of dental experience, specializing in cosmetic dentistry and sleep apnea treatment.',
    href: '/doctors/patricia-swaintek-lamb-dmd/',
    label: 'Meet Dr. Patti',
  },
  {
    title: 'Meet Our Team',
    text: 'From your first phone call to your last polish, a close-knit team of hygienists and patient care coordinators looks after every visit.',
    href: '/doctors/',
    label: 'Meet Our Team',
  },
  {
    title: 'About Us',
    text: 'We take a holistic approach to dental treatment, because oral health affects the health of your whole body.',
    href: '/about/',
    label: 'Learn More About Us',
  },
  {
    title: 'Visit Our Office',
    text: 'Find us at 10 Anderson Hill Road in Bernardsville, NJ — with hand warmers, scented pillows, and entertainment to make every visit pleasant.',
    href: '/locations/bernardsville/',
    label: 'Get Directions',
  },
];

// Verbatim from reference/content-proudtosmile.md section 5 (homepage quotes).
const testimonials = [
  {
    quote:
      'I have been going to Dr. Patti for the last 25 years. She is the best. Her practice is very tech savvy unlike other dentists.',
    author: 'Naresh P.',
    context: 'Patient of 25 years',
  },
  {
    quote:
      "Dr. Patti is not only efficient and knowledgeable, but she's also one of the most empathetic, kind, and personable dentists I've ever met.",
    author: 'Jose O.',
    context: 'February 2025',
  },
  {
    quote:
      'The competency, efficiency and kindness of Dr. Patti and her team was extraordinary!',
    author: 'Carol Z.',
    context: 'April 2023',
  },
];

// "Everything You Need for Better Dental Care" — the reference's 4-col cards.
const resources = [
  {
    title: 'New Patients',
    text: 'Getting started with better dental health is simple. Learn what to expect before your first visit.',
    href: '/patient-center/new-patients/',
    label: 'Get More Information',
  },
  {
    title: 'Patient Forms',
    text: 'Save time by completing your new-patient paperwork online before you arrive.',
    href: '/patient-center/patient-forms/',
    label: 'Download Forms',
  },
  {
    title: 'Insurance',
    text: 'We work with most major insurance providers to help you get the most from your coverage.',
    href: '/patient-center/insurance/',
    label: 'Am I Covered?',
  },
  {
    title: 'Pricing',
    text: 'Quality dental care should be accessible. Explore transparent pricing and flexible payment options.',
    href: '/patient-center/pricing/',
    label: 'Learn More About Pricing',
  },
];
---

<BaseLayout
  title="Dentist in Bernardsville, NJ | Proud To Smile Dentistry"
  description="Cosmetic, family, and general dentistry in Bernardsville, NJ. Call 908-221-1188 or book online with Dr. Patricia Swaintek-Lamb, DMD."
>
  <Header currentPath="/" />

  <main id="main-content">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Insurance strip -->
    <InsuranceStrip />

    <!-- 3. Full-width office photograph band -->
    <section class="pt-[var(--spacing-section-sm)]">
      <div class="container-page">
        <img
          src="/images/proudtosmile/dental-services.webp"
          alt="Treatment room at Proud To Smile Dentistry in Bernardsville, NJ"
          width="1420"
          height="700"
          loading="lazy"
          class={`panel h-56 w-full object-cover ${focusFor('dental-services.webp')} sm:h-80 lg:h-[26rem]`}
        />
      </div>
    </section>

    <!-- 4. What Sets Us Apart -->
    <section class="py-[var(--spacing-section)]" aria-labelledby="apart-heading">
      <div class="container-page">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-16">
          <div>
            <h2 id="apart-heading">What Sets Us Apart</h2>
            <p class="mt-6 text-neutral-700">
              Patients choose Proud To Smile because we&rsquo;re a warm, welcoming place to be — not a
              run-of-the-mill dental office. We blend modern, state-of-the-art dentistry with a
              close-knit team that genuinely cares.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-2 lg:col-span-2">
            {apartBlocks.map((block) => (
              <div>
                <h3>{block.title}</h3>
                <p class="mt-3 text-neutral-700">{block.text}</p>
                <a href={block.href} class="link-arrow mt-4">
                  {block.label}
                  <ArrowCircle />
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Testimonials -->
    <section class="pb-[var(--spacing-section)]" aria-labelledby="testimonials-heading">
      <div class="container-page">
        <TestimonialPanel quotes={testimonials} />
      </div>
    </section>

    <!-- 6. Services grid -->
    <section class="pb-[var(--spacing-section)]" aria-labelledby="services-heading">
      <div class="container-page">
        <h2 id="services-heading" class="max-w-2xl">Discover Quality Dental Care for Every Smile</h2>
        <p class="mt-6 max-w-3xl text-neutral-700">
          From routine cleanings to complete smile makeovers, explore our comprehensive dental
          services. Cosmetic, family, and general dentistry &amp; orthodontic care, all under one
          roof in Bernardsville — each treatment delivered with attention to your comfort and
          long-term oral health.
        </p>

        <div class="mt-12">
          <ServicesGrid />
        </div>
      </div>
    </section>

    <!-- 7. Everything You Need for Better Dental Care -->
    <section class="bg-secondary-50 py-[var(--spacing-section)]" aria-labelledby="resources-heading">
      <div class="container-page">
        <h2 id="resources-heading" class="max-w-2xl">Everything You Need for Better Dental Care</h2>
        <p class="mt-6 max-w-3xl text-neutral-700">
          We&rsquo;re committed to making your dental care experience smooth and stress-free.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {resources.map((resource) => (
            <div class="card flex flex-col">
              <h3 class="text-xl">{resource.title}</h3>
              <p class="mt-3 flex-1 text-sm text-neutral-700">{resource.text}</p>
              <a href={resource.href} class="link-arrow mt-6">
                {resource.label}
                <ArrowCircle />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Closing CTA -->
    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
