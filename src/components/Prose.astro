---
// component-builder: Prose
// Purpose: Typographic wrapper for the single-column rich-text bodies used by
// About, Patient Center, legal, and blog pages. The design system has no
// Tailwind typography plugin, so element styles are declared here once rather
// than being re-applied per page.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['prose-body', className]}>
  <slot />
</div>

<style>
  @reference "../styles/global.css";

  .prose-body {
    @apply text-neutral-700;
  }
  .prose-body :global(> * + *) {
    @apply mt-6;
  }
  .prose-body :global(h2) {
    @apply mt-12 text-neutral-900;
    font-size: var(--font-size-3xl);
  }
  .prose-body :global(h3) {
    @apply mt-10 text-neutral-900;
  }
  .prose-body :global(h2 + *),
  .prose-body :global(h3 + *) {
    @apply mt-4;
  }
  .prose-body :global(ul),
  .prose-body :global(ol) {
    @apply space-y-2 pl-6;
  }
  .prose-body :global(ul) {
    @apply list-disc;
  }
  .prose-body :global(ol) {
    @apply list-decimal;
  }
  .prose-body :global(li)::marker {
    color: var(--color-primary-600);
  }
  .prose-body :global(a) {
    @apply font-medium text-primary-700 underline underline-offset-2 hover:no-underline;
  }
  .prose-body :global(strong) {
    @apply font-semibold text-neutral-900;
  }
  .prose-body :global(blockquote) {
    @apply border-l-4 border-primary-200 pl-6 text-lg italic;
  }
  .prose-body :global(table) {
    @apply w-full border-collapse text-left text-sm;
  }
  .prose-body :global(th),
  .prose-body :global(td) {
    @apply border-b border-border py-3 pr-4;
  }
  .prose-body :global(th) {
    @apply font-semibold text-neutral-900;
  }
</style>
