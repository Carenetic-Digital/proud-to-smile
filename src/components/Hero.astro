---
// component-builder: Hero
// Purpose: Homepage hero — headline, subhead, dual CTA, Google rating trust
// signal, and the LCP-critical hero photograph bleeding to the band edge.
// Layout and copy are the client-approved Concept C (v3) version.
import ArrowCircle from './ArrowCircle.astro';
import { focusFor } from '../data/imageFocus';

const HERO_IMAGE = '/images/proudtosmile/hero-woman-at-dentist.webp';

const ZOCDOC_URL =
  'https://www.zocdoc.com/practice/proud-to-smile-dentistry-90291?lock=true&referrerType=widget';
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-secondary-50">
  <div class="container-page">
    <!-- Split at xl, not lg: the source hero photograph is landscape
         (1420x700), and a two-column split below 1280px crops it into a
         blurry portrait while squeezing the h1 to five lines. This also
         matches Header.astro's deliberate xl nav breakpoint. -->
    <div class="grid grid-cols-1 xl:grid-cols-2 xl:items-stretch xl:gap-16">
      <div class="flex flex-col justify-center py-14 xl:py-24">
        <h1 class="text-neutral-900">You&rsquo;ve found your dental home in Bernardsville, NJ</h1>
        <p class="mt-6 max-w-xl text-lg text-neutral-700">
          Comprehensive general and cosmetic dentistry from a team that treats you like family —
          modern technology, genuine compassion, and over 25 years of experience under one roof.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="tel:+19082211188" class="btn btn-primary">
            Call 908-221-1188
            <ArrowCircle />
          </a>
          <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn btn-outline">
            Schedule Appointment
            <ArrowCircle />
          </a>
        </div>
        <div class="mt-8 flex items-center gap-2 text-sm text-neutral-700">
          <span class="flex" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5 fill-current text-primary-600" viewBox="0 0 20 20">
                <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.62.99-5.8-4.21-4.1 5.82-.85L10 1.5Z" />
              </svg>
            ))}
          </span>
          <span class="font-semibold text-neutral-900">4.96</span>
          <span>on Google</span>
        </div>
      </div>

      <div class="relative min-h-[18rem] pb-12 sm:min-h-[24rem] lg:min-h-[28rem] xl:min-h-[34rem] xl:pb-0">
        <img
          src={HERO_IMAGE}
          alt="Smiling patient at Proud To Smile Dentistry in Bernardsville, NJ"
          width="1420"
          height="700"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          {/* Focal point comes from src/data/imageFocus.ts. */}
          class={`panel absolute inset-x-0 top-0 h-[18rem] w-full object-cover ${focusFor(HERO_IMAGE)} sm:h-[24rem] lg:h-[28rem] xl:bottom-0 xl:h-full xl:rounded-b-none`}
        />
      </div>
    </div>
  </div>
</section>
