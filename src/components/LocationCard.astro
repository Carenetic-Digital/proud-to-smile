---
// component-builder: LocationCard
// Purpose: The practice card from the reference's "Find Quality Dental Care
// Near You" block. The real practice has a single location, so this renders
// once rather than in a multi-location row.
import ArrowCircle from './ArrowCircle.astro';
import { ADDRESS, PHONE, PHONE_HREF, HOURS, MAPS_URL, PRACTICE } from '../data/site';
---

<div class="card border-t-4 border-t-accent-200">
  <h3 class="text-xl">{PRACTICE}</h3>
  <address class="mt-3 not-italic text-sm leading-relaxed text-neutral-700">
    {ADDRESS}<br />
    <a href={PHONE_HREF} class="font-semibold text-primary-700 hover:underline">{PHONE}</a>
  </address>

  <h4 class="mt-6 text-sm font-semibold uppercase tracking-wide text-neutral-900">Hours</h4>
  <ul class="mt-2 space-y-1 text-sm text-neutral-700">
    {
      HOURS.map((h) => (
        <li class="flex justify-between gap-4">
          <span>{h.day}</span>
          <span>{h.time}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex flex-wrap gap-4">
    <a href="/locations/bernardsville/" class="link-arrow">
      Location Details
      <ArrowCircle />
    </a>
    <a href={MAPS_URL} target="_blank" rel="noopener" class="link-arrow">
      Get Directions
      <ArrowCircle />
    </a>
  </div>
</div>
