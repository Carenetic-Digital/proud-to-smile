---
// component-builder: TestimonialPanel
// Purpose: Large dark rounded panel of patient quotes with the decorative
// quote glyph. The site-wide social-proof block — reuse verbatim on service,
// doctor, and location pages by passing a different `quotes` set.
//
// Quotes are real reviews from reference/content-proudtosmile.md section 5.
// Never fabricate a testimonial to fill this component.
import ArrowCircle from './ArrowCircle.astro';

interface Quote {
  quote: string;
  author: string;
  context: string;
}

interface Props {
  quotes: Quote[];
  headingId?: string;
}

const { quotes, headingId = 'testimonials-heading' } = Astro.props;
---

<div class="panel bg-primary-800 px-6 py-14 text-white sm:px-12 lg:px-20 lg:py-20">
  <h2 id={headingId} class="sr-only">What our patients say</h2>
  <svg class="mx-auto h-10 w-14 fill-current text-accent-200" viewBox="0 0 56 40" aria-hidden="true">
    <path d="M0 40V22.9C0 10.6 6.9 2 18.6 0l2.3 5.4C14.4 7.6 10.6 12 10.3 18.6H21V40H0Zm35 0V22.9C35 10.6 41.9 2 53.6 0l2.3 5.4C49.4 7.6 45.6 12 45.3 18.6H56V40H35Z" />
  </svg>

  <ul class="mx-auto mt-10 max-w-3xl space-y-6">
    {quotes.map((t) => (
      <li class="rounded-[var(--radius-md)] bg-white/10 px-6 py-8 text-center sm:px-10">
        <blockquote>
          <p class="text-lg leading-relaxed">&ldquo;{t.quote}&rdquo;</p>
          <footer class="mt-4 text-sm text-white/85">
            <cite class="not-italic font-semibold">{t.author}</cite>
            <span aria-hidden="true"> | </span>
            {t.context}
          </footer>
        </blockquote>
      </li>
    ))}
  </ul>

  <div class="mt-10 text-center">
    <a href="/testimonials/" class="btn btn-on-dark">
      Read All Reviews
      <ArrowCircle />
    </a>
  </div>
</div>
