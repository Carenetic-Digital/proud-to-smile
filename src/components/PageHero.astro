---
// component-builder: PageHero
// Purpose: The interior-page hero from the design reference — H1 + intro on a
// tinted gradient band, with an optional photograph filling the right half
// (reference/screenshots/patient-resources-new-patients.png).
//
// Use on every page except the homepage, which has its own richer Hero.
import ArrowCircle from './ArrowCircle.astro';
import { PHONE, PHONE_HREF, ZOCDOC_URL } from '../data/site';
import { focusFor } from '../data/imageFocus';

interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
  /** Show the phone + booking CTA pair under the intro. */
  cta?: boolean;
}

const { title, intro, eyebrow, image, imageAlt = '', cta = false } = Astro.props;

// This band crops a 2:1 source into boxes as narrow as 1.3:1, so an
// off-centre subject needs its own focal point — see src/data/imageFocus.ts.
const focus = focusFor(image);
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-secondary-50">
  <div class="container-page">
    <div class:list={['grid grid-cols-1 gap-10', image && 'lg:grid-cols-2 lg:items-center lg:gap-16']}>
      <div class="py-12 lg:py-20">
        {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary-700">{eyebrow}</p>}
        <h1 class="text-neutral-900">{title}</h1>
        {intro && <p class="mt-6 max-w-2xl text-lg text-neutral-700">{intro}</p>}
        {
          cta && (
            <div class="mt-8 flex flex-wrap gap-4">
              <a href={PHONE_HREF} class="btn btn-primary">
                Call {PHONE}
                <ArrowCircle />
              </a>
              <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn btn-outline">
                Schedule Appointment
                <ArrowCircle />
              </a>
            </div>
          )
        }
        <slot />
      </div>

      {
        image && (
          <div class="pb-12 lg:pb-0">
            <img
              src={image}
              alt={imageAlt}
              width="1420"
              height="700"
              loading="eager"
              fetchpriority="high"
              class={`panel h-64 w-full object-cover ${focus} sm:h-80 lg:h-[26rem]`}
            />
          </div>
        )
      }
    </div>
  </div>
</section>
