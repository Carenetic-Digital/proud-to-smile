---
// component-builder: Footer
// Purpose: Site-wide footer — practice info, hours, nav columns, social,
// and legal link row. Content sourced from reference/content-proudtosmile.md.

const PHONE = '908-221-1188';
const PHONE_HREF = 'tel:+19082211188';
const ADDRESS = '10 Anderson Hill Road, Bernardsville, NJ 07924';
const ZOCDOC_URL =
  'https://www.zocdoc.com/practice/proud-to-smile-dentistry-90291?lock=true&referrerType=widget';

const hours = [
  { day: 'Monday', time: '8:00 AM – 12:00 PM' },
  { day: 'Tuesday', time: '9:00 AM – 6:00 PM' },
  { day: 'Wednesday', time: '9:00 AM – 6:00 PM' },
  { day: 'Thursday', time: '7:00 AM – 4:00 PM' },
  { day: 'Friday', time: '8:00 AM – 12:00 PM' },
  { day: 'Saturday', time: 'Closed' },
  { day: 'Sunday', time: 'Closed' },
];

const quickLinks = [
  { label: 'Schedule Appointment', href: ZOCDOC_URL, external: true },
  { label: 'Doctors', href: '/doctors/' },
  { label: 'Smile Gallery', href: '/smile-gallery/' },
  { label: 'Offers & Promotions', href: '/offers-promotions/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'News & Press', href: '/about/news/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Testimonials', href: '/testimonials/' },
  { label: 'Refer a Patient', href: '/refer-a-patient/' },
];

const patientCenterLinks = [
  { label: 'New Patients', href: '/patient-center/new-patients/' },
  { label: 'Patient Forms', href: '/patient-center/patient-forms/' },
  { label: 'Insurance', href: '/patient-center/insurance/' },
  { label: 'Pricing', href: '/patient-center/pricing/' },
  { label: 'Financial Options', href: '/patient-center/financial-options/' },
  { label: 'Bill Pay', href: '/bill-pay/' },
  { label: 'FAQs', href: '/patient-center/faqs/' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms & Conditions', href: '/terms-conditions/' },
  { label: 'HIPAA Compliance Statement', href: '/hipaa-compliance-statement/' },
  { label: 'Cookie Policy', href: '/cookie-policy/' },
  { label: 'Disclaimer', href: '/disclaimer/' },
  { label: 'Accessibility Statement', href: '/accessibility-statement/' },
  { label: 'Consent for Treatment', href: '/consent-for-treatment/' },
  { label: 'Notice of Non-discrimination', href: '/notice-of-non-discrimination/' },
  { label: 'Patient Rights & Responsibilities', href: '/patient-rights-responsibilities/' },
  { label: 'Financial Policies', href: '/financial-policies/' },
  { label: 'Grievance Procedure', href: '/grievance-procedure/' },
];

const currentYear = new Date().getUTCFullYear();
---

<footer class="bg-secondary-700 text-white">
  <div class="border-t-4 border-accent-200"></div>

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <img
          src="/images/proudtosmile/logo.webp"
          alt=""
          width="416"
          height="160"
          loading="lazy"
          class="mb-4 h-10 w-auto brightness-0 invert"
        />
        <address class="not-italic text-sm leading-relaxed text-white/80">
          <a href="/locations/bernardsville/" class="hover:text-white hover:underline">{ADDRESS}</a><br />
          <a href={PHONE_HREF} class="font-medium text-white hover:underline">{PHONE}</a>
        </address>
        <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-white/75">Hours</h2>
        <ul class="mt-2 space-y-1 text-sm text-white/80">
          {hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.day}</span>
              <span>{h.time}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white/75">Patient Center</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {patientCenterLinks.map((link) => (
            <li><a href={link.href} class="text-white/80 hover:text-white hover:underline">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white/75">Quick Links</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
                class="text-white/80 hover:text-white hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white/75">Follow Us</h2>
        <ul class="mt-3 flex gap-3">
          <li>
            <a
              href="https://www.facebook.com/Proudtosmile/"
              target="_blank"
              rel="noopener"
              aria-label="Proud To Smile Dentistry on Facebook"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/proudtosmile/"
              target="_blank"
              rel="noopener"
              aria-label="Proud To Smile Dentistry on Instagram"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.2 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.74.07-.97.04-1.5.21-1.85.34-.46.18-.79.4-1.14.75-.35.35-.56.68-.75 1.14-.13.35-.3.88-.34 1.85C3.11 8.5 3.1 8.85 3.1 12s.01 3.5.08 4.74c.04.97.21 1.5.34 1.85.18.46.4.79.75 1.14.35.35.68.56 1.14.75.35.13.88.3 1.85.34 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.97-.04 1.5-.21 1.85-.34.46-.18.79-.4 1.14-.75.35-.35.56-.68.75-1.14.13-.35.3-.88.34-1.85.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.04-.97-.21-1.5-.34-1.85a3.03 3.03 0 0 0-.75-1.14 3.03 3.03 0 0 0-1.14-.75c-.35-.13-.88-.3-1.85-.34C15.5 4.01 15.15 4 12 4Zm0 3.38a4.62 4.62 0 1 1 0 9.24 4.62 4.62 0 0 1 0-9.24Zm0 1.8a2.82 2.82 0 1 0 0 5.64 2.82 2.82 0 0 0 0-5.64Zm4.8-1.99a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/channel/UClzPIteZ-7o4VpC3dbZ2UFA"
              target="_blank"
              rel="noopener"
              aria-label="Proud To Smile Dentistry on YouTube"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 7.2a3.02 3.02 0 0 0-2.12-2.14C19.5 4.6 12 4.6 12 4.6s-7.5 0-9.38.46A3.02 3.02 0 0 0 .5 7.2 31.6 31.6 0 0 0 .04 12a31.6 31.6 0 0 0 .46 4.8 3.02 3.02 0 0 0 2.12 2.14c1.88.46 9.38.46 9.38.46s7.5 0 9.38-.46a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 23.96 12a31.6 31.6 0 0 0-.46-4.8ZM9.6 15.4V8.6L15.8 12l-6.2 3.4Z" />
              </svg>
            </a>
          </li>
        </ul>
        <p class="mt-6 text-xs leading-relaxed text-white/75">
          Member: ADA · NJDA · AGD · IAFGG · AAGO · AADSM
        </p>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-xs text-white/75">
      <p>&copy; {currentYear} Proud To Smile Dentistry. All rights reserved.</p>
      <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
        {legalLinks.map((link, i) => (
          <li class="flex items-center gap-2">
            <a href={link.href} class="py-1 hover:text-white hover:underline">{link.label}</a>
            {i < legalLinks.length - 1 && <span aria-hidden="true" class="text-white/30">|</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
