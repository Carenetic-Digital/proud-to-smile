---
// component-builder: RelatedServices
// Purpose: The "related services" row that closes every service page on the
// design reference.
import ArrowCircle from './ArrowCircle.astro';
import { services } from '../data/services';

interface Props {
  slugs: string[];
  heading?: string;
}

const { slugs, heading = 'Related Services' } = Astro.props;
const related = slugs
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => Boolean(s));
---

{
  related.length > 0 && (
    <section class="bg-secondary-50 py-[var(--spacing-section)]" aria-labelledby="related-heading">
      <div class="container-page">
        <h2 id="related-heading">{heading}</h2>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((service) => (
            <div class="card flex flex-col">
              <h3 class="text-xl">{service.title}</h3>
              <p class="mt-3 flex-1 text-sm text-neutral-700">{service.heroIntro}</p>
              <a href={`/service/${service.slug}/`} class="link-arrow mt-6">
                Learn More About {service.title}
                <ArrowCircle />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
