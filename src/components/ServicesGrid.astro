---
// component-builder: ServicesGrid
// Purpose: The site's service grid — two columns, each block listing its
// sub-treatments over a divider rule and closing with a full-width bar
// button. This is the client-approved Concept C (v3) treatment and the
// standard for every page that lists services (homepage, /services/, doctor
// and location pages), per reference/analysis.md.
//
// Sub-treatments condensed from reference/content-proudtosmile.md section 4 —
// the practice's 14 real services. "Clear Aligner Therapy" is the on-page
// name; the slug stays `invisalign` for SEO continuity.
import ArrowCircle from './ArrowCircle.astro';

interface Service {
  title: string;
  slug: string;
  items: string[];
}

interface Props {
  /** Restrict the grid to these slugs (in the order given). Omit for all 14. */
  only?: string[];
}

const { only } = Astro.props;

const allServices: Service[] = [
  {
    title: 'Cleanings',
    slug: 'cleaning',
    items: ['Comprehensive Exams', 'Plaque & Tartar Removal', 'Polishing & Flossing', 'Preventive Care Education'],
  },
  {
    title: 'Veneers',
    slug: 'veneers',
    items: ['Porcelain Veneers', 'Trial Smile Preview', 'Chip & Gap Correction', 'Smile Makeover Planning'],
  },
  {
    title: 'Teeth Whitening',
    slug: 'teeth-whitening',
    items: ['Opalescence BOOST In-Office', 'Stain & Discoloration Removal', 'Whitening Maintenance'],
  },
  {
    title: 'Emergency Dentistry',
    slug: 'emergency-dentistry',
    items: [
      'Same-Day Appointments',
      'Knocked-Out Tooth',
      'Cracked or Chipped Teeth',
      'Loose or Lost Restorations',
      'Severe Tooth Pain',
      'Gum Swelling & Abscess',
    ],
  },
  {
    title: 'Crowns',
    slug: 'crowns',
    items: ['All-Porcelain Crowns', 'Porcelain-Fused-to-Metal', 'Root Canal Restorations', 'Implant Crowns'],
  },
  {
    title: 'Clear Aligner Therapy',
    slug: 'invisalign',
    items: ['Aligners for Adults', 'Aligners for Teens', 'Crowding & Gaps', 'Bite Correction'],
  },
  {
    title: 'Dental Implants',
    slug: 'dental-implants',
    items: ['Single-Tooth Implants', 'Implant-Supported Bridges', 'Implant-Supported Dentures', 'Surgical Placement'],
  },
  {
    title: 'Botox',
    slug: 'botox',
    items: ['Teeth Grinding & Clenching', 'Gummy Smile Treatment', 'Jaw Muscle Tension', 'Tension Headaches'],
  },
  {
    title: 'Dentures',
    slug: 'dentures',
    items: ['Conventional Dentures', 'Immediate Dentures', 'Implant-Supported Dentures', 'Denture Care & Maintenance'],
  },
  {
    title: 'Periodontal Therapy',
    slug: 'periodontal-therapy',
    items: ['Scaling & Root Planing', 'Laser Gum Therapy', 'Antibiotic Therapy', 'Flap Surgery & Grafts'],
  },
  {
    title: 'Cosmetic & Restorative Dentistry',
    slug: 'cosmetic-and-restorative-dentistry',
    items: ['Gum Recontouring', 'Dental Bonding', 'Tooth-Colored Fillings', 'Porcelain Inlays & Onlays'],
  },
  {
    title: 'Extractions & Oral Surgery',
    slug: 'extractions-oral-surgery',
    items: ['Tooth Extractions', 'Wisdom Teeth Removal', 'Implant Placement Surgery', 'Periodontal Surgery', 'Biopsy Procedures'],
  },
  {
    title: 'Pediatric Dentistry',
    slug: 'pediatric-dentistry',
    items: ["Children's Cleanings & Exams", 'Dental Sealants', 'Fluoride Treatments', 'Digital X-Rays for Kids', "Kids' Restorations"],
  },
  {
    title: 'Sleep Apnea Treatment',
    slug: 'sleep-apnea',
    items: ['Airway-Focused Diagnostics', 'Oral Appliance Therapy', 'Snoring Solutions', 'TMJ & Airway Care'],
  },
];

const services = only
  ? only.map((slug) => allServices.find((s) => s.slug === slug)).filter((s): s is Service => Boolean(s))
  : allServices;
---

<div class="grid grid-cols-1 gap-x-8 gap-y-12 lg:grid-cols-2">
  {services.map((service) => (
    <div class="flex flex-col">
      <h3>{service.title}</h3>
      <ul class="mt-4 grid flex-1 grid-cols-1 gap-x-8 gap-y-2 text-sm text-neutral-700 sm:grid-cols-2">
        {service.items.map((item) => (
          <li class="border-b border-border py-2">{item}</li>
        ))}
      </ul>
      <a href={`/service/${service.slug}/`} class="btn-bar mt-6">
        Learn More About {service.title}
        <ArrowCircle />
      </a>
    </div>
  ))}
</div>
