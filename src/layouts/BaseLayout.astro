---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';
import { practiceSchema, websiteSchema } from '../data/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Cosmetic, Family, and General Dentistry & Orthodontic Dentistry in Bernardsville, NJ.',
  image,
  noindex = false,
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preconnect to external origins (fonts, analytics) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts with font-display: swap for performance -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon set (derived from public/images/proudtosmile/practice-icon.webp) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#1249E9" />

    <!-- SEO Meta Tags (includes Open Graph and Twitter Cards) -->
    <SEOHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <!-- Site-wide entity graph: one Dentist node and one WebSite node, both
         carrying stable @ids so per-page schema references them instead of
         declaring competing businesses. -->
    <StructuredData type="Dentist" data={practiceSchema(Astro.site)} />
    <StructuredData type="WebSite" data={websiteSchema(Astro.site)} />
    <!-- BugHerd visual feedback (staging only — remove before launch) -->
    <script
      is:inline
      type="text/javascript"
      src="https://www.bugherd.com/sidebarv2.js?apikey=qfutgpp1xfxfslr6zitj6a"
      async="true"></script>
  </head>
  <body class="font-body text-neutral-900 bg-white antialiased">
    <slot />
  </body>
</html>
