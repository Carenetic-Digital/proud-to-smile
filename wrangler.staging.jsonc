{
  "name": "proud-to-smile-staging",
  "compatibility_date": "2026-02-01",
  "account_id": "6ba8d559dd652da1003752c4674dfa6c",
  "assets": {
    "directory": "./dist",
    // Without this, an unknown path returns a bare 404 with an empty body and
    // src/pages/404.astro never renders — verified on the staging Worker.
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "proud-to-smile.spark0.io",
      "custom_domain": true
    }
  ]
}
